diff --git a/packages/client/ui-chat/src/client/presentation-overrides.ts b/packages/client/ui-chat/src/client/presentation-overrides.ts
new file mode 100644
index 0000000000..62d0905d75
--- /dev/null
+++ b/packages/client/ui-chat/src/client/presentation-overrides.ts
@@ -0,0 +1,117 @@
+/**
+ * Session-scoped transcript presentation overrides owned by the Chat target.
+ *
+ * The deployment-wide work-details mode stays the user's choice for ordinary
+ * Sessions. A conversation a product presents as chat — a Bot chat — can ask
+ * the Chat view for a quieter transcript instead, without touching what the
+ * user selected in Settings. Overrides are keyed by Session, and the derived
+ * policy keeps a stable identity per (Session, mode), so memoized renderers
+ * and selectors never churn.
+ * @module @deepseek-ai/dsh-client-ui-chat/src/client/presentation-overrides
+ */
+
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { ChatPresentationPolicy } from './presentation-policy.ts'
+
+/** Presentation fields one product may adjust for its own conversation. */
+export interface ChatPresentationOverride {
+  /** Hide the model's reasoning rows for this conversation. */
+  readonly hideReasoning?: boolean
+  /** Hide the Turn process controller (worked label and elapsed time). */
+  readonly hideTurnProcess?: boolean
+  /** Hide the per-Turn usage pill. */
+  readonly hideTurnUsage?: boolean
+  /** Hide the composer-dock session statistics. */
+  readonly hideSessionStats?: boolean
+}
+
+/** Face other client packages use to quiet one Session's transcript. */
+export interface IChatTranscript {
+  /**
+   * Install or replace one Session's override.
+   * @param sessionId - conversation the override belongs to.
+   * @param override - presentation fields to change.
+   */
+  set(sessionId: SessionId, override: ChatPresentationOverride): void
+
+  /**
+   * Drop one Session's override, restoring the deployment policy.
+   * @param sessionId - conversation whose override is removed.
+   */
+  clear(sessionId: SessionId): void
+
+  /**
+   * Resolve the presentation one Session renders with.
+   * @param sessionId - conversation being rendered.
+   * @param base - the deployment policy observable the Session otherwise uses.
+   * @returns the base observable without an override, else a stable observable
+   * folding the override over each mode; it notifies exactly when the base does.
+   */
+  for(sessionId: SessionId, base: ObservableSnapshot<ChatPresentationPolicy>): ObservableSnapshot<ChatPresentationPolicy>
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Session-scoped transcript presentation overrides; absent without the Chat target. */
+    chatTranscript: IChatTranscript
+  }
+}
+
+/** One derived policy, remembered by the resolved mode it was folded from. */
+interface DerivedPolicy {
+  readonly mode: ChatPresentationPolicy
+  readonly value: ChatPresentationPolicy
+}
+
+/** One Session's wrapper observable over the deployment policy source. */
+interface SessionPolicySource extends ObservableSnapshot<ChatPresentationPolicy> {
+  readonly base: ObservableSnapshot<ChatPresentationPolicy>
+}
+
+/** The Chat target's override registry. */
+export class ChatTranscriptOverrides implements IChatTranscript {
+  private readonly overrides = new Map<SessionId, ChatPresentationOverride>()
+  private readonly derived = new Map<SessionId, DerivedPolicy>()
+  private readonly sources = new Map<SessionId, SessionPolicySource>()
+
+  set(sessionId: SessionId, override: ChatPresentationOverride): void {
+    this.overrides.set(sessionId, override)
+    this.derived.delete(sessionId)
+  }
+
+  clear(sessionId: SessionId): void {
+    if (this.overrides.delete(sessionId)) this.derived.delete(sessionId)
+  }
+
+  for(
+    sessionId: SessionId,
+    base: ObservableSnapshot<ChatPresentationPolicy>,
+  ): ObservableSnapshot<ChatPresentationPolicy> {
+    if (!this.overrides.has(sessionId)) {
+      this.sources.delete(sessionId)
+      return base
+    }
+    const existing = this.sources.get(sessionId)
+    if (existing !== undefined && existing.base === base) return existing
+    const source: SessionPolicySource = {
+      base,
+      getSnapshot: () => this.resolve(sessionId, base),
+      subscribe: listener => base.subscribe(listener),
+    }
+    this.sources.set(sessionId, source)
+    return source
+  }
+
+  /** Fold the current override over the base's current mode, memoized by mode identity. */
+  private resolve(sessionId: SessionId, base: ObservableSnapshot<ChatPresentationPolicy>): ChatPresentationPolicy {
+    const mode = base.getSnapshot()
+    const cached = this.derived.get(sessionId)
+    if (cached !== undefined && cached.mode === mode) return cached.value
+    const override = this.overrides.get(sessionId)
+    if (override === undefined) return mode
+    const value: ChatPresentationPolicy = { ...mode, ...override }
+    this.derived.set(sessionId, { mode, value })
+    return value
+  }
+}
