+/**
+ * Project a list snapshot onto the Sessions the browser shows: Sessions
+ * another surface presents (a Bot's own chat) leave both membership and
+ * metadata. Every derivation resolves its members through the snapshot, so
+ * one projection hides them from the grouped tree, the flat list, and search
+ * alike. The snapshot identity is preserved when nothing is hidden, and a
+ * Workspace account still listing a projected-away Session renders no row for
+ * it (members without a summary are skipped, like a late list pull).
+ * @param list - authoritative list snapshot.
+ * @param hidden - Sessions the browser leaves to their presenting surface.
+ * @returns the same snapshot, or a membership/metadata copy without them.
+ */
+export function withoutHiddenSessions(
+  list: SessionListState,
+  hidden: ReadonlySet<SessionId>,
+): SessionListState {
+  if (hidden.size === 0) return list
+  let dropped = false
+  const ids = list.ids.filter((id) => {
+    if (!hidden.has(id)) return true
+    dropped = true
+    return false
+  })
+  const byId: Record<SessionId, SessionSummary> = {}
+  for (const [id, summary] of Object.entries(list.byId) as [SessionId, SessionSummary][]) {
+    if (hidden.has(id)) {
+      dropped = true
+      continue
+    }
+    byId[id] = summary
+  }
+  return dropped ? { ...list, ids, byId } : list
+}
