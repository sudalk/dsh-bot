@@ -0,0 +1,28 @@
+/**
+ * Sessions another client surface presents itself, and the Workspace browser
+ * therefore leaves to that surface: a product that gives its conversations
+ * their own home — the Bot roster does, for each Bot's continuing chat —
+ * publishes them here, and the browser omits them from the grouped tree, the
+ * flat list, and search alike, so the owning surface stays the only way in.
+ * The face is optional: without it every Session shows.
+ * @module @deepseek-ai/dsh-client-ui-workspace/src/client/visibility
+ */
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** Face a client surface provides to keep its own conversations out of the browser. */
+export interface ISessionVisibility {
+  /**
+   * Sessions to omit. Membership is the contract, not identity: the set may be
+   * replaced whenever the presenting surface updates, and the browser
+   * republishes only when membership itself moves.
+   */
+  readonly hidden: ObservableSnapshot<ReadonlySet<SessionId>>
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Sessions another surface presents; absent without such a surface. */
+    sessionVisibility: ISessionVisibility
+  }
+}
